# Set to true to use dummy data in development.
DUMMY_DATA=true

# Weather (MET/Yr)
WEATHER_LAT=
WEATHER_LON=
WEATHER_LOCATION_NAME=
WEATHER_USER_AGENT=

# Asana
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=

# Monotree (Open API v1 – https://docs.monotree.com)
# Base uten sti; /api/open/v1 legges på automatisk. API-nøkkel er "mono_..."-token.
MONOTREE_BASE_URL=https://dyreparken.monotree.com
MONOTREE_API_KEY=
# Komma-separerte vegg-ID-er som skal vises (192 = "IT"-veggen). Flere: 192,29,316
MONOTREE_WALL_IDS=192

# LibreNMS
LIBRENMS_BASE_URL=
LIBRENMS_API_TOKEN=
LIBRENMS_SWITCH_REGEX=

# Graylog
GRAYLOG_BASE_URL=
GRAYLOG_API_TOKEN=
GRAYLOG_USERNAME=
GRAYLOG_PASSWORD=
GRAYLOG_QUERY=*
GRAYLOG_RANGE_SECONDS=1800
GRAYLOG_LIMIT=10
GRAYLOG_SORT=timestamp:desc
GRAYLOG_FIELDS=timestamp,source,level,message,facility,facility_string,gl2_source_input,_id
GRAYLOG_ALLOW_DUMMY=false

# NinjaOne
NINJAONE_DEVICES_URL=
NINJAONE_ACCESS_TOKEN=

# Esper
ESPER_DEVICES_URL=
ESPER_API_TOKEN=
ESPER_OFFLINE_AFTER_MINUTES=1440

# Zoined
ZOINED_GUESTS_URL=
ZOINED_API_KEY=
ZOINED_PUBLIC_REPORT_URL=
ZOINED_DYREPARKEN_TITLE=Gjester i dag - Dyreparken
ZOINED_BADELAND_TITLE=Gjester i dag - Badelandet
ZOINED_CACHE_TTL_MS=60000

# Entur (Realtime GraphQL)
ENTUR_API_URL=https://api.entur.io/journey-planner/v3/graphql
ENTUR_CLIENT_NAME=
ENTUR_STOP_PLACE_ID=
ENTUR_STOP_PLACE_IDS=
ENTUR_MAX_DEPARTURES=10
